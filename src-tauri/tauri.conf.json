{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Launcher",
  "version": "1.0.1",
  "identifier": "com.orbit.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orbit Launcher",
        "width": 1240,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-context-menu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; media-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' https: ipc: http://ipc.localhost; font-src 'self' data:; frame-src https://unmid.github.io;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Fast, simple Minecraft launcher",
    "publisher": "Orbit Launcher Contributors",
    "copyright": "Copyright © 2026 Orbit Launcher Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/unmid/OrbitLauncher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNDJEMDM0Rjc4QTA2OUMKUldTY0JvcjNOTkJDM05aS3JnUjQwVmVwRmN1VVVPS08yS1NLSlkxRHdkaTc4R2Z6SHNZSzcwbFYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
