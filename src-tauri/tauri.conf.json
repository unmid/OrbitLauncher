{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Launcher (beta)",
  "version": "3.0.0",
  "identifier": "com.orbit.launcher.beta",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orbit Launcher (beta)",
        "width": 1180,
        "height": 720,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-context-menu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; media-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' https: ipc: http://ipc.localhost; font-src 'self' data:; frame-src https://unmid.github.io;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "shortDescription": "Fast, simple Minecraft launcher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
